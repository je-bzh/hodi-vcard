# .htaccess pour www.hodi.live/vcard/
DirectoryIndex index.html

RewriteEngine On

# 0) On ne touche PAS à /api/* ni /uploads/* : l'API a son propre routeur
#    (api/.htaccess → index.php) et les uploads sont servis en statique.
RewriteRule ^api(/|$) - [L]
RewriteRule ^uploads/ - [L]

# 1a) Pages admin → rendu serveur (gate session + hydratation) par page.php.
RewriteRule ^(my-info|my-wallpapers|email-signature)/?$ page.php?page=$1 [L,QSA]

# 1b) Autres URLs sans extension : /first-login → first-login.html (si le fichier existe).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.+?)/?$ $1.html [L,QSA]

# 2) Pretty URLs vCard : /{slug} → vcard.php?slug={slug} (rendu serveur)
#    Le navigateur garde /jerome dans la barre d'adresse ; Apache exécute vcard.php
#    en interne. Ne s'applique qu'aux segments "slug-like" qui ne sont pas une page.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/?$ vcard.php?slug=$1 [L,QSA]

# 3) Fallback : si rien ne correspond → index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ index.html [L]

# Cache long sur les assets statiques
<FilesMatch "\.(css|js|svg|png|jpg|jpeg|gif|woff2?|ico)$">
    Header set Cache-Control "max-age=31536000, public"
</FilesMatch>

# HTML : pas de cache (pour que les nouvelles versions soient prises immédiatement)
<FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
