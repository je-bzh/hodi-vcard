<!DOCTYPE html>
<html lang="fr" data-auth-required>
{{> head }}
<body>
	<div class="wrapper">
		{{> header }}

		<div class="main">
			<section class="section-tiles">
				<div class="shell shell--small">
					<div class="filters">
						<a href="#" class="btn js-toggle-filters">
							<span></span>
							
							<img src="public/assets/images/temp/ico-chevron.png" alt="">
						</a>

						<ul class="list-filters js-filters">
							<li>
								<a href="mes-infos.html" class="btn" data-i18n="tabs.my_info">My information</a>
							</li>
	
							<li class="is-active">
								<a href="#" class="btn">Mes fonds d’écran</a>
							</li>
	
							<li>
								<a href="#" class="btn">Ma signature mail</a>
							</li>
						</ul><!-- /.list-filters -->
					</div><!-- /.filters -->

					<div class="tiles-images">
						<p>Créez jusqu’à 6 fond d’écran QR personnalisés différents pour votre smartphone :</p>

						<div class="grid-flex">
							<div class="grid__col grid__col--1of3">
								<div class="tile-image js-tile">
									<picture>
										<source media="(max-width:767px)" srcset="public/assets/images/temp/tile-1.png">
										<img src="public/assets/images/temp/tile-1.png" alt="" class="js-crop-image">
									</picture>

									<ul class="tile__actions">
										<li>
											<a href="#popup-choice" class="js-toggle-popup">
												<img src="public/assets/images/svg/ico-upload-1.svg" alt="">
											</a>
										</li>
										
										<li>
											<a href="#">
												<img src="public/assets/images/svg/ico-remove-1.svg" alt="">
											</a>
										</li>
									</ul><!-- /.tile__actions -->
								</div><!-- /.tile -->
							</div><!-- /.grid__col -->

							<div class="grid__col grid__col--1of3">
								<div class="tile-image js-tile">
									<picture>
										<source media="(max-width:767px)" srcset="public/assets/images/temp/tile-2.png">
										<img src="public/assets/images/temp/tile-2.png" alt="" class="js-crop-image">
									</picture>

									<ul class="tile__actions">
										<li>
											<a href="#popup-choice" class="js-toggle-popup">
												<img src="public/assets/images/svg/ico-upload-1.svg" alt="">
											</a>
										</li>
										
										<li>
											<a href="#">
												<img src="public/assets/images/svg/ico-remove-1.svg" alt="">
											</a>
										</li>
									</ul><!-- /.tile__actions -->
								</div><!-- /.tile -->
							</div><!-- /.grid__col -->

							<div class="grid__col grid__col--1of3">
								<div class="tile-image js-tile">
									<div class="tile__overlay">
										<img src="public/assets/images/svg/ico-tile.svg" alt="">

										<h6>Ajouter</h6>
									</div><!-- /.tile__overlay -->
								</div><!-- /.tile -->
							</div><!-- /.grid__col -->
						</div><!-- /.grid-flex -->
					</div><!-- /.tiles -->

					<div class="section__actions">
						<a href="#" class="btn btn--block btn--aqua">Créer un nouveau fond d’écran</a><!-- /.btn -->
					</div><!-- /.section__actions -->
				</div><!-- /.shell -->
			</section><!-- /.section-form -->
		</div><!-- /.main -->

		<div class="popups popups--cropper not-visible" id="popup-choice">
			<div class="popups__inner">
				<div class="popup">
					<div class="popup__head">
						<h4>Nouveau fond d’écran mobile</h4>

						<a href="#popup-choice" class="popup__close js-toggle-popup">
							<img src="public/assets/images/svg/ico-close.svg" alt="">
						</a><!-- /.popup__close -->
					</div><!-- /.popup__head -->

					<div class="image-cropper">
						<img class="image-cropper-icon" src="public/assets/images/svg/ico-image-cropper.svg" alt="">

						<h6>faites glisser votre image ici ou ...</h6>

						<div class="image-cropper__upload">
							<input type="file" id="upload-image" class="btn btn--aqua" accept="image/*">
							<span class="btn btn--aqua">Parcourir</span>
						</div><!-- /.image-cropper-upload -->

						<div class="js-croppie"></div><!-- /.js-croppie -->

						<div class="zoom-actions">
							<button id="zoom-in-button">
								<img src="public/assets/images/svg/zoom-in.svg" alt="">
							</button>

							<button id="zoom-out-button">
								<img src="public/assets/images/svg/zoom-out.svg" alt="">
							</button>
						</div><!-- /.zoom-actions -->

						<p>Maximum 2 Mo, fichier JPG ou PNG</p>

					</div>
					
					<a href="#" class="btn btn--block btn--aqua btn--is-hidden" id="crop-button">Sauvegarder mon fond d’écran</a><!-- /.btn -->
				</div><!-- /.popup -->
			</div><!-- /.popups__inner -->
		</div><!-- /.popups -->


		{{> footer }}
	</div><!-- /.wrapper -->

	{{> scripts }}
</body>
</html>
