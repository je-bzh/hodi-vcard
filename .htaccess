# .htaccess pour www.hodi.live/vcard/
DirectoryIndex index.html

RewriteEngine On

# Pretty URLs vCard : /vcard/{slug} → /vcard/ma-vcard.html?slug={slug}
# Le navigateur garde /vcard/jerome dans la barre d'adresse, mais Apache
# sert ma-vcard.html en interne avec le slug en query string.
# Match uniquement les paths "slug-like" (lettres/chiffres/tirets/underscore).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/?$ ma-vcard.html?slug=$1 [L,QSA]

# Si le fichier demandé n'existe pas → on sert index.html (fallback)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ index.html [L]

# Cache long sur les assets statiques
<FilesMatch "\.(css|js|svg|png|jpg|jpeg|gif|woff2?|ico)$">
    Header set Cache-Control "max-age=31536000, public"
</FilesMatch>

# HTML : pas de cache (pour que les nouvelles versions soient prises immédiatement)
<FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
