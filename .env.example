# Variables d'environnement — Hodi vCard
# Copie ce fichier en .env et remplis les valeurs.
# La publishable key est sûre côté client tant que RLS est activée sur les tables.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Unsplash API (banque d'images publique)
# 1. Crée un compte développeur : https://unsplash.com/developers
# 2. Crée une app → copie l'Access Key
# 3. Free tier : 50 requêtes/heure (suffisant pour usage perso)
# 4. NB : la clé est exposée côté client (préfixe VITE_) ; pour la prod, passer
#    par un Edge Function proxy serait plus propre.
VITE_UNSPLASH_ACCESS_KEY=
